# HTTPS in front of the app. Caddy gets and renews the Let's Encrypt certificate for DOMAIN by
# itself; the domain's A record must point at this server before the first start.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		-Server
	}

	# Only the health status is exposed by the app; nothing else under /actuator should answer.
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404

	reverse_proxy app:8080
}

# Production settings. On the server: cp .env.example .env, fill it in, chmod 600 .env.
# Never commit .env. docs/DEPLOY.md says where each value comes from.

# --- The server ---
# The domain whose A record points at this server, without https://, e.g. app.dorak.me
DOMAIN=
# Database password, e.g. from: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# --- WhatsApp Cloud API (Meta app dashboard) ---
WA_APP_SECRET=
# Any random string; the same value goes into Meta's webhook settings. openssl rand -hex 24
WA_VERIFY_TOKEN=
# e.g. v26.0; check the current version in Meta's docs
WA_GRAPH_VERSION=
# Encrypts the clinics' WhatsApp tokens in the database: openssl rand -base64 32
# Keep a copy in your password manager. Lose it and every clinic must reconnect WhatsApp.
TOKEN_ENCRYPTION_KEY=

# --- Operator alerts (Telegram) ---
# From @BotFather; the chat id from https://api.telegram.org/bot<token>/getUpdates after you message the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backups to Backblaze B2 ---
# An application key limited to the one bucket (Read and Write)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Encrypts the dumps before they leave the server: openssl rand -base64 32
# Keep a copy in your password manager. Without it the backups cannot be read.
BACKUP_PASSPHRASE=
# Optional: when (Beirut time) and how many days of dumps to keep in B2
# BACKUP_TIME=03:30
# BACKUP_KEEP_DAYS=30

# --- Billing ---
# How clinics pay you, shown on their Billing page, e.g. Whish 70 123 456 (Omar). Optional.
BILLING_PAY_TO=

# --- Image (normally leave as is) ---
# DORAK_IMAGE=ghcr.io/omar-al-sayed1/dorak
# DORAK_TAG=latest
